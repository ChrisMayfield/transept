# Secrets
.env

# May include names of members. Keep these out of a public repository.
glossary.txt
keyterms.txt

# config.toml is deliberately NOT ignored. Settings are worth committing to
# your own fork so a second room can start from a known-good file.

# Recordings, transcripts, and review documents. A recorded session holds
# every word said in the room, so it is more sensitive than the glossary.
*.wav
*.flac
transcript*.txt
review*.md
review/
sessions.db
sessions.db-wal
sessions.db-shm

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ruff_cache/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
*.swp
