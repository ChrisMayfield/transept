# Settings and API keys. A fork can commit its own copy so a second room
# starts from a known-good file, but only after taking out the API keys.
config.toml

# May include names of members. Keep these out of a public repository.
glossary.txt
keyterms.txt

# What a running server leaves behind. The log holds both addresses with
# the tokens that run minted, and the record names the process to stop.
transept.log
transept.pid

# Recordings, transcripts, and review documents. A recorded session holds
# every word said in the room, so it is more sensitive than the glossary.
*.wav
*.flac
transcript*.txt
review*.md
review/
sessions.db
sessions.db-wal
sessions.db-shm

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ruff_cache/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
*.swp
