# Copy this file to .env and fill in your own values.
# .env is gitignored. Never commit real keys.

# Speech recognition. Create a key at https://console.deepgram.com
# New accounts include free credit that covers a long time at a few
# services a week.
DEEPGRAM_API_KEY=

# Translation. Any OpenAI-compatible chat completions endpoint works.
# The base URL must be the part before /chat/completions.
#
#   Google            https://generativelanguage.googleapis.com/v1beta/openai
#   Anthropic         https://api.anthropic.com/v1
#   OpenAI            https://api.openai.com/v1
#   Local Ollama      http://localhost:11434/v1
#   LiteLLM proxy     http://your-proxy:4000/v1
LLM_BASE_URL=
LLM_API_KEY=

# The operator token is not here. It is minted on every run and printed
# with the operator address when the server starts.
