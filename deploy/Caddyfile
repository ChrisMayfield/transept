# Caddy in front of the Transept rooms on one server, for the deployment
# HOSTED.md describes. Copy to /etc/caddy/Caddyfile, put the real hostname in
# place of transept.example.org, check it with `caddy validate --config
# /etc/caddy/Caddyfile`, and reload with `systemctl reload caddy`.
#
# Each room lives under its own name, which is the same name as its working
# directory, its systemd instance, and its [server] room setting. Caddy
# strips that prefix before forwarding, so the server behind it serves
# /reader and /control exactly as it does on a laptop, and reader_address on
# that side puts the prefix back into the address on the card.

transept.example.org {
	# Every request the reader port serves carries the reader token in its
	# query string, so the log is kept and the token is hashed rather than
	# written out. The hash is the first four bytes of its SHA-256, which
	# still tells one card's token from another, so a rotation or a stale
	# card is visible in the log without the log being a copy of the card.
	#
	# `replace token REDACTED` instead drops the value entirely, and
	# removing the format block logs the address whole. Caddy's own errors
	# are a different logger and reach the journal either way.
	log {
		format filter {
			wrap console
			request>uri query {
				hash token
			}
		}
	}

	# One room. A second room is a copy of this block with the other name
	# and the other two ports, and nothing else: no second certificate, no
	# second DNS record, and no second thing to forget when one changes.
	handle_path /chapel/* {
		# The room laptop's websocket. Caddy upgrades it without being
		# asked and passes the query string through, which is where
		# sender.dial puts the control token. This matcher is more
		# specific than the one below, so it is the one that answers.
		handle /control {
			reverse_proxy 127.0.0.1:8081
		}

		# The reader page, the channel list, and the event streams. Caddy
		# stops buffering a response of its own accord once it sees
		# text/event-stream, so a subtitle reaches a phone when it is
		# written rather than when a buffer fills.
		handle {
			reverse_proxy 127.0.0.1:8080
		}
	}

	# A second room, on the ports its own config.toml names.
	handle_path /classroom/* {
		handle /control {
			reverse_proxy 127.0.0.1:8083
		}
		handle {
			reverse_proxy 127.0.0.1:8082
		}
	}

	# Nothing at the root, and no room named to guess at. A bot that finds
	# the hostname gets the same 404 the reader port gives it, rather than
	# whichever room happens to be listed first.
	handle {
		respond 404
	}

	# No `encode` directive on purpose. Compression buffers, and the event
	# streams it would buffer are nearly all of this traffic, to save
	# nothing on a reader page that is one small file.
}
