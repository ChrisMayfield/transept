#!/bin/sh
# Find a Python, then hand the whole job to transept.py.
#
#     ./transept start | stop | restart | status
#
# This exists so that one spelling of the command works on all three
# platforms. A shebang cannot choose between .venv/bin/python3 and
# .venv/Scripts/python.exe, and on Windows there is often no python3 at
# all, so the choice lives here rather than in a line transept.py cannot
# change. Everything else is Python.
cd "$(dirname "$0")" || exit 1

for candidate in .venv/bin/python3 .venv/Scripts/python.exe; do
    if [ -x "$candidate" ]; then
        exec "$candidate" transept.py "$@"
    fi
done
for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1; then
        exec "$candidate" transept.py "$@"
    fi
done

echo "No Python found. See step 1 of SETUP.md."
exit 1
